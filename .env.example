# Copie para .env. Nunca coloque estas chaves no frontend.
OPENAI_API_KEY=
TYPESAFE_API_KEY=
# Clef no Cloudflare Workers AI: ID da conta (32 caracteres) e token com permissão Workers AI.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Usa a autenticação existente do CLI. Não requer chave da Anthropic.
CLAUDE_BIN=claude
# Argumentos antes das opções do Claude, em lista JSON. Para um executável ou perfil próprio:
# CLAUDE_BIN=/caminho/para/seu-executavel
# CLAUDE_ARGS='["seu-perfil"]'
CLAUDE_ARGS=[]
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_TIMEOUT_MS=180000
# Limite por chamada do CLI, quando aplicável à modalidade de autenticação.
CLAUDE_MAX_BUDGET_USD=0.50
PROVIDER_TIMEOUT_MS=30000
# Pausas do piloto automático da maratona: entre rodadas e entre reuniões.
AUTOPLAY_DELAY_MS=8000
SERIES_PAUSE_MS=14000
# Chamadas simultâneas por provedor na rodada brava.
BRAVA_CONCURRENCY=3
OPENAI_MODEL=gpt-6-luna
JEV_MODEL=jev-1.13.0
# clef ou clef-flash
CLEF_MODEL=clef
PORT=4318
DATA_DIR=./data
